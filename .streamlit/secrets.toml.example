# このファイルをコピーして「secrets.toml」という名前で保存し、値を書き込む。
# secrets.toml は .gitignore に入っているので GitHub には上がらない。
# Streamlit Community Cloud では、アプリの Settings → Secrets に同じ内容を貼り付ける。

# YouTube Data API のキー（手元で使う場合。公開版では設定しなくてもよい）
YOUTUBE_API_KEY = "ここにAPIキーを書く"

# 公開版（Streamlit Community Cloud）では true にする
# PUBLIC_MODE = "true"
# 公開版でも自分だけYouTube取得を使いたい場合の合言葉（他人に教えない）。
# 設定しなければ公開版ではYouTube取得は無効（CSVと架空データだけで動く）
# APP_PASSCODE = "長くて推測されにくい合言葉"
